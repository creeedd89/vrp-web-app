datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  watchlists    Watchlist[]
  portfolios    Portfolio[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  contractId String // The ID of the option contract (e.g. "CALL-5500-30D")
  addedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contractId])
}

model ChainSnapshot {
  id        String   @id @default(cuid())
  symbol    String
  timestamp DateTime @default(now())
  avgIV     Float
  avgVRP    Float
  putCallRatio Float

  @@index([symbol, timestamp])
}

model Portfolio {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions Position[]
}

model Position {
  id          String    @id @default(cuid())
  portfolioId String
  symbol      String    
  contractId  String    
  type        String    
  quantity    Int       
  entryPrice  Float

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}
